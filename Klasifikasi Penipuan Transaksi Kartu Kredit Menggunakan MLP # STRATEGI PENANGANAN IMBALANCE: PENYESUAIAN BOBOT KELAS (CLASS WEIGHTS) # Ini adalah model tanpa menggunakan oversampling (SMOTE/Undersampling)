        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.preprocessing import StandardScaler, RobustScaler\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "from sklearn.metrics import confusion_matrix, classification_report, f1_score\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense, Dropout\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# =======================================================\n",
        "# JUDUL PROYEK: Klasifikasi Penipuan Transaksi Kartu Kredit Menggunakan MLP\n",
        "# STRATEGI PENANGANAN IMBALANCE: PENYESUAIAN BOBOT KELAS (CLASS WEIGHTS)\n",
        "# Ini adalah model tanpa menggunakan oversampling (SMOTE/Undersampling)\n",
        "# =======================================================\n",
        "\n",
        "# =======================================================\n",
        "# KONFIGURASI GLOBAL\n",
        "# =======================================================\n",
        "# Daftar path yang paling mungkin untuk dimuat.\n",
        "POTENTIAL_PATHS = [\n",
        "    \"creditcard_01.csv\",\n",
        "    \"creditcard.csv\",\n",
        "    \"archive.zip/creditcard.csv\",\n",
        "    \"archive.zip\"\n",
        "]\n",
        "RANDOM_SEED = 42\n",
        "EPOCHS = 15\n",
        "BATCH_SIZE = 2048\n",
        "THRESHOLD_BASELINE = 0.50 # Ambang batas keputusan standar\n",
        "\n",
        "# =======================================================\n",
        "# FASE 1: PRA-PEMROSESAN DATA (MUAT, NORMALISASI, SPLIT)\n",
        "# =======================================================\n",
        "\n",
        "print(\"--- FASE 1: PRA-PEMROSESAN DATA ---\")\n",
        "\n",
        "def load_data_robustly(paths):\n",
        "    \"\"\"Mencoba memuat data dari daftar path yang diberikan.\"\"\"\n",
        "    df = None\n",
        "    for path in paths:\n",
        "        try:\n",
        "            # Jika path berakhir dengan .zip, coba gunakan compression='zip'\n",
        "            if path.endswith('.zip'):\n",
        "                df = pd.read_csv(path, compression='zip')\n",
        "                print(f\"✅ Data berhasil dimuat dari file ZIP secara langsung ('{path}'). Ukuran data: {df.shape}\")\n",
        "            else:\n",
        "                df = pd.read_csv(path)\n",
        "                print(f\"✅ Data berhasil dimuat dari '{path}'. Ukuran data: {df.shape}\")\n",
        "            # Mengubah nama kolom Class menjadi lowercase jika diperlukan, sesuai file fraud_detection_final.py\n",
        "            if 'Class' in df.columns:\n",
        "                df.rename(columns={'Class': 'class'}, inplace=True)\n",
        "            return df\n",
        "        except Exception:\n",
        "            # Jika gagal, coba path berikutnya\n",
        "            continue\n",
        "\n",
        "    # Jika semua path gagal\n",
        "    print(f\"❌ ERROR: Gagal memuat data. Mohon pastikan file data (zip atau csv) sudah diunggah dan dapat diakses.\")\n",
        "    print(f\"Path yang dicoba: {paths}\")\n",
        "    return None # Kembalikan None jika gagal\n",
        "\n",
        "# Panggil fungsi pemuatan robust\n",
        "df = load_data_robustly(POTENTIAL_PATHS)\n",
        "\n",
        "# Lanjutkan pemrosesan hanya jika df berhasil dimuat\n",
        "if df is not None:\n",
        "\n",
        "    # 1. Pisahkan fitur 'Time' dan 'Amount' untuk penskalaan\n",
        "    # Fitur V1-V28 sudah dianonimkan dan tidak perlu penskalaan tambahan.\n",
        "\n",
        "    # 2. Penskalaan Fitur 'Amount' menggunakan RobustScaler (lebih tahan outlier)\n",
        "    scaler_amount = RobustScaler()\n",
        "    df['Scaled_Amount'] = scaler_amount.fit_transform(df['Amount'].values.reshape(-1, 1))\n",
        "    df.drop(['Amount'], axis=1, inplace=True)\n",
        "\n",
        "    # 3. Penskalaan Fitur 'Time' menggunakan StandardScaler (untuk data yang terdistribusi normal)\n",
        "    scaler_time = StandardScaler()\n",
        "    df['Scaled_Time'] = scaler_time.fit_transform(df['Time'].values.reshape(-1, 1))\n",
        "    df.drop(['Time'], axis=1, inplace=True)\n",
        "\n",
        "    # 4. Susun ulang kolom agar Scaled_Time dan Scaled_Amount berada di awal\n",
        "    scaled_amount = df['Scaled_Amount']\n",
        "    scaled_time = df['Scaled_Time']\n",
        "    df.drop(columns=['Scaled_Amount', 'Scaled_Time'], inplace=True)\n",
        "    df.insert(0, 'Scaled_Amount', scaled_amount)\n",
        "    df.insert(0, 'Scaled_Time', scaled_time)\n",
        "\n",
        "    # 5. Pembagian Data Latih (Train) dan Data Uji (Test)\n",
        "    X = df.drop('class', axis=1)\n",
        "    y = df['class']\n",
        "\n",
        "    # Stratify=y memastikan rasio kelas (fraud) tetap sama di train dan test\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y,\n",
        "        test_size=0.3,\n",
        "        random_state=RANDOM_SEED,\n",
        "        stratify=y\n",
        "    )\n",
        "    print(f\"✅ Data dibagi: Train ({X_train.shape}), Test ({X_test.shape})\")\n",
        "\n",
        "    # =======================================================\n",
        "    # FASE 2: PEMBANGUNAN DAN PELATIHAN MODEL MLP DENGAN CLASS WEIGHTS\n",
        "    # =======================================================\n",
        "\n",
        "    print(\"\\n--- FASE 2: MODEL MLP DENGAN CLASS WEIGHTS (TANPA SMOTE) ---\")\n",
        "\n",
        "    # 6. Tangani Bobot Kelas (Class Weights)\n",
        "    # Ini menghitung bobot secara otomatis berdasarkan inverse frekuensi\n",
        "    weights = compute_class_weight(\n",
        "        class_weight='balanced',\n",
        "        classes=np.unique(y_train),\n",
        "        y=y_train\n",
        "    )\n",
        "    # Bobot akan berbentuk {0: bobot_normal, 1: bobot_fraud}\n",
        "    class_weights = {0: weights[0], 1: weights[1]}\n",
        "    print(f\"Bobot Kelas Dihitung: {class_weights}\")\n",
        "    print(f\"Rasio bobot Fraud terhadap Normal: {class_weights[1]/class_weights[0]:.2f}\")\n",
        "\n",
        "\n",
        "    # 7. Bangun Model MLP\n",
        "    input_shape = X_train.shape[1]\n",
        "    model = Sequential([\n",
        "        tf.keras.layers.Input(shape=(input_shape,)),\n",
        "        Dense(32, activation='relu'),\n",
        "        Dropout(0.3), # Dropout untuk mencegah overfitting\n",
        "        Dense(16, activation='relu'),\n",
        "        Dropout(0.3),\n",
        "        Dense(1, activation='sigmoid') # Sigmoid untuk klasifikasi biner\n",
        "    ])\n",
        "\n",
        "    # 8. Kompilasi Model\n",
        "    model.compile(\n",
        "        optimizer='adam',\n",
        "        loss='binary_crossentropy',\n",
        "        metrics=['accuracy', tf.keras.metrics.Recall(), tf.keras.metrics.Precision()]\n",
        "    )\n",
        "\n",
        "    # Tampilkan ringkasan model\n",
        "    print(\"\\nRingkasan Arsitektur Model MLP:\")\n",
        "    model.summary()\n",
        "\n",
        "    # 9. Pelatihan Model\n",
        "    print(\"\\nMemulai Pelatihan Model (Menggunakan Class Weights)...\")\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        batch_size=BATCH_SIZE,\n",
        "        epochs=EPOCHS,\n",
        "        class_weight=class_weights, # Kelas bobot diterapkan di sini\n",
        "        validation_data=(X_test, y_test),\n",
        "        verbose=1\n",
        "    )\n",
        "    print(\"✅ Pelatihan model selesai!\")\n",
        "\n",
        "    # Dapatkan probabilitas prediksi\n",
        "    y_pred_proba = model.predict(X_test, verbose=0)\n",
        "\n",
        "\n",
        "    # =======================================================\n",
        "    # FASE 3: EVALUASI KINERJA PADA DATA UJI ASLI\n",
        "    # =======================================================\n",
        "\n",
        "    print(\"\\n--- FASE 3: EVALUASI KINERJA PADA DATA UJI ASLI ---\")\n",
        "\n",
        "    # Terapkan ambang batas keputusan\n",
        "    y_pred = (y_pred_proba > THRESHOLD_BASELINE).astype(int)\n",
        "\n",
        "    # Menghitung metrik\n",
        "    print(f\"\\nLaporan Klasifikasi (Threshold {THRESHOLD_BASELINE}):\")\n",
        "    report = classification_report(y_test, y_pred, target_names=['Normal (0)', 'Fraud (1)'])\n",
        "    print(report)\n",
        "\n",
        "    # Menghitung dan menampilkan Confusion Matrix\n",
        "    cm = confusion_matrix(y_test, y_pred)\n",
        "    tn, fp, fn, tp = cm.ravel()\n",
        "\n",
        "    print(\"\\nConfusion Matrix:\")\n",
        "    print(f\"  [ {tn}  {fp} ]  <-- Aktual Normal\")\n",
        "    print(f\"  [ {fn}   {tp} ]  <-- Aktual Fraud\")\n",
        "    print(f\"    ^       ^\")\n",
        "    print(f\"    |       |\")\n",
        "    print(f\"  Prediksi Prediksi\")\n",
        "    print(f\"  Normal  Fraud\")\n",
        "\n",
        "    print(\"\\nKeterangan Metrik Utama (Fokus pada Fraud):\")\n",
        "    print(f\"True Positives (TP - Fraud terdeteksi benar): {tp}\")\n",
        "    print(f\"False Negatives (FN - Fraud terlewat): {fn}\")\n",
        "    print(f\"False Positives (FP - Alarm Palsu): {fp}\")\n",
        "    print(f\"Precision (Fraud): {tp / (tp + fp):.4f}\")\n",
        "    print(f\"Recall (Fraud): {tp / (tp + fn):.4f}\")\n",
        "    print(f\"F1-Score (Fraud): {f1_score(y_test, y_pred):.4f}\")\n",
        "\n",
        "\n",
        "    # Visualisasi Confusion Matrix\n",
        "    plt.figure(figsize=(8, 6))\n",
        "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
        "                xticklabels=['Normal (0)', 'Fraud (1)'],\n",
        "                yticklabels=['Normal (0)', 'Fraud (1)'])\n",
        "    plt.title(f'Confusion Matrix (MLP with Class Weights, Threshold {THRESHOLD_BASELINE:.2f})')\n",
        "    plt.xlabel('Prediksi')\n",
        "    plt.ylabel('Aktual')\n",
        "    plt.show()\n",
        "\n",
        "    # 10. Menyimpan Model\n",
        "    MODEL_FILENAME = 'fraud_model_class_weights_no_smote.h5'\n",
        "    try:\n",
        "        model.save(MODEL_FILENAME)\n",
        "        print(f\"\\n✅ Model MLP (Class Weights) telah berhasil disimpan sebagai '{MODEL_FILENAME}'.\")\n",
        "    except Exception as e:\n",
        "        print(f\"\\n❌ Gagal menyimpan model. Error: {e}\")"
      ],
